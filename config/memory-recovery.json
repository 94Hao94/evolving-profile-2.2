    {"id":"retain","dimensions":["facts","experiences","entities"]},
    {"id":"consolidation","dimensions":["observations"]},
    {"id":"preference_models","dimensions":["preferences","mental_models"]},
    {"id":"scenarios","dimensions":["session_summaries","project_summaries"]},
    {"id":"agent_process","dimensions":["agent_traces","agent_events","agent_episodes","agent_patterns","agent_strategies","agent_capabilities","agent_revalidation"]}
