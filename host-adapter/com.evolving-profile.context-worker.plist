<plist version="1.0"><dict>
<key>Label</key><string>com.evolving-profile.context-worker</string>
<key>ProgramArguments</key><array>
<string>/Users/apple/.evolving-profile/runtime/python-3.11/bin/python</string>
<string>/Users/apple/.evolving-profile/runtime/host-adapter/context-incremental-worker.py</string>
